#!/bin/sh
# Matronix Browser launcher (vendored from MatronixOwner/Matronix_Browser).
DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -f "$DIR/matronix-browser/matronix.py" ]; then
  exec python3 "$DIR/matronix-browser/matronix.py" "$@"
else
  exec python3 /usr/share/matronix-browser/matronix.py "$@"
fi
