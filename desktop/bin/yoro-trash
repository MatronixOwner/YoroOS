#!/bin/sh
# Launcher for Yoro app 'trashapp' (works both from the repo and installed).
DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -d "$DIR/yoroapps" ]; then
  PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m yoroapps.trashapp "$@"
else
  PYTHONPATH="/usr/share/yoroos${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m yoroapps.trashapp "$@"
fi
