# MatroOS: soft horizon, animated waiting dots (not a percentage indicator).
Window.SetBackgroundTopColor(0.025, 0.055, 0.105);
Window.SetBackgroundBottomColor(0.075, 0.15, 0.25);
logo = Image("logo.png");
logo_sprite = Sprite(logo);
logo_sprite.SetX(Window.GetWidth()/2 - logo.GetWidth()/2);
logo_sprite.SetY(Window.GetHeight()/2 - 125);
word = Image("wordmark.png");
word_sprite = Sprite(word);
word_sprite.SetX(Window.GetWidth()/2 - word.GetWidth()/2);
word_sprite.SetY(Window.GetHeight()/2 + 45);
dot = Image("dot.png");
for (i = 0; i < 3; i++) {
    dots[i] = Sprite(dot);
    dots[i].SetX(Window.GetWidth()/2 - 25 + i*20);
    dots[i].SetY(Window.GetHeight()/2 + 115);
}
tick = 0;
fun refresh () {
    tick++;
    for (i = 0; i < 3; i++) {
        if ((Math.Int(tick / 14) % 3) == i) dots[i].SetOpacity(1.0);
        else dots[i].SetOpacity(0.28);
    }
}
Plymouth.SetRefreshFunction(refresh);
